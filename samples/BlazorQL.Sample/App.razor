@namespace BlazorQL.Sample
@using BlazorQL
@inject SidecarStore Sidecar

<div class="sample-shell">
    <div class="endpoint-bar">
        <input data-testid="endpoint"
               placeholder="GraphQL endpoint url — empty runs the built-in schema in your browser"
               @bind="endpoint" />
        <button type="button" data-testid="endpoint-apply" @onclick="Apply">Apply</button>
    </div>
    <BlazorQLIde Fetcher="fetcher" DefaultQuery="@DemoQuery.Text" />
</div>
<BlazorQLSidecar />

@code {

    IGraphQLFetcher fetcher = null!;

    string endpoint = "";

    // begin-snippet: sampleFetcher
    // The whole schema lives in the browser by default: GraphQL.NET executes it inside the WASM
    // app itself, so the sample deploys to static hosting with subscriptions intact. The sidecar
    // decorator records every request the IDE makes into the debug panel.
    protected override void OnInitialized() =>
        fetcher = new SidecarFetcher(new LocalSchemaFetcher(), Sidecar);
    // end-snippet

    // Empty falls back to the in-browser schema; ws(s):// speaks graphql-transport-ws; anything
    // else posts over http. Swapping the parameter makes the IDE re-introspect.
    void Apply()
    {
        var url = endpoint.Trim();
        IGraphQLFetcher transport;
        if (url.Length == 0)
        {
            transport = new LocalSchemaFetcher();
        }
        else if (url.StartsWith("ws://", StringComparison.OrdinalIgnoreCase) ||
                 url.StartsWith("wss://", StringComparison.OrdinalIgnoreCase))
        {
            transport = new GraphQLWsFetcher(url);
        }
        else
        {
            transport = new HttpFetcher(url);
        }

        fetcher = new SidecarFetcher(transport, Sidecar);
    }

}
