@namespace BlazorQL
@using BlazorMonaco.Editor
@inject IJSRuntime JS

<div class="blazorql" data-testid="blazorql" data-ready="@(ready ? "true" : null)">
    <Sidebar Visible="visiblePlugin"
             OnToggle="TogglePlugin"
             Refetching="refetching"
             OnRefetch="RefetchSchema"
             Theme="themes.Current"
             OnThemeToggle="CycleTheme"
             OnOpenShortKeys="OpenShortKeys"
             OnOpenSettings="OpenSettings" />
    <div class="blazorql-main">
        @if (visiblePlugin is not null)
        {
            <PluginPane Kind="visiblePlugin.Value"
                        Style="@Grow(pluginPane.Ratio)"
                        Schema="Schema"
                        SdlProvider="sdlProvider"
                        Navigator="docNavigator"
                        OnGenerateQuery="LoadGeneratedQuery"
                        OnCopyGenerated="CopyGenerated"
                        History="history"
                        OnHistorySelect="LoadHistoryItem" />
        }
        <PaneResizer Id="@pluginResizerId" Direction="x" Hidden="visiblePlugin is null" OnReset="() => ResetPane(pluginPane)" />
        <div class="blazorql-sessions" style="@Grow(visiblePlugin is null ? 1 : 1 - pluginPane.Ratio)">
            <header class="blazorql-session-header">
                <TabBar Store="tabs"
                        OnActivate="ActivateTab"
                        OnClose="CloseTab"
                        OnAdd="AddTab"
                        OnRename="RenameTab" />
            <div class="blazorql-logo">
                @if (Logo is null)
                {
                    <a href="https://github.com/SimonCropp/BlazorQL" target="_blank" rel="noreferrer">Blazor<em>QL</em></a>
                }
                else
                {
                    @Logo
                }
            </div>
            </header>
            <div class="blazorql-session">
                <div class="blazorql-editors-column" style="@Grow(sessionPane.Ratio)">
                    <div class="blazorql-editor-section" style="@(toolsExpanded ? Grow(toolsPane.Ratio) : "flex: 1 1 0%")">
                        <div class="blazorql-editors">
                            <section class="blazorql-editor-host" aria-label="Operation Editor">
                                @if (hydrated)
                                {
                                    <StandaloneCodeEditor @ref="operationEditor"
                                                          Id="@OperationElementId"
                                                          CssClass="blazorql-editor"
                                                          ConstructionOptions="OperationOptions"
                                                          OnDidInit="OnOperationInit"
                                                          OnDidChangeModelContent="OnOperationContentChanged"
                                                          OnMouseDown="OnOperationMouseDown" />
                                }
                            </section>
                        </div>
                        <div class="blazorql-toolbar" role="toolbar" aria-label="Editor Commands">
                            <div class="blazorql-execute-wrap">
                                <button type="button"
                                        class="blazorql-execute"
                                        data-testid="execute"
                                        title="@(running ? "Stop query" : "Execute query (Ctrl-Enter)")"
                                        aria-label="@(running ? "Stop query" : "Execute query (Ctrl-Enter)")"
                                        @onclick="ExecuteClicked">@(running ? "■" : "▶")</button>
                                @if (pickerOpen)
                                {
                                    <div class="blazorql-operation-picker" data-testid="operation-picker" role="menu">
                                        @foreach (var operation in pickerOperations)
                                        {
                                            var item = operation;
                                            <button type="button"
                                                    role="menuitem"
                                                    @onclick="() => RunPicked(item)">@(item.Name ?? $"<Unnamed {item.Kind}>")</button>
                                        }
                                    </div>
                                }
                            </div>
                            <button type="button"
                                    class="blazorql-toolbar-button"
                                    data-testid="prettify"
                                    title="Prettify query (Shift-Ctrl-P)"
                                    aria-label="Prettify query (Shift-Ctrl-P)"
                                    @onclick="PrettifyEditors">
                                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M15 4l5 5L7 22H2v-5z"/>
                                    <path d="M18.5 2.5L21 5"/>
                                </svg>
                            </button>
                            <button type="button"
                                    class="blazorql-toolbar-button"
                                    data-testid="merge"
                                    title="Merge fragments into query (Shift-Ctrl-M)"
                                    aria-label="Merge fragments into query (Shift-Ctrl-M)"
                                    @onclick="MergeFragments">
                                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M7 3v6a6 6 0 0 0 6 6h4"/>
                                    <path d="M13 11l4 4-4 4"/>
                                    <path d="M7 21v-6"/>
                                </svg>
                            </button>
                            <button type="button"
                                    class="blazorql-toolbar-button"
                                    data-testid="copy"
                                    title="Copy query (Shift-Ctrl-C)"
                                    aria-label="Copy query (Shift-Ctrl-C)"
                                    @onclick="CopyQuery">
                                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <rect x="9" y="9" width="12" height="12" rx="2"/>
                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                                </svg>
                            </button>
                            <button type="button"
                                    class="blazorql-toolbar-button"
                                    data-testid="share"
                                    title="Copy a link to this query"
                                    aria-label="Copy a link to this query"
                                    @onclick="ShareQuery">
                                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <circle cx="18" cy="5" r="3"/>
                                    <circle cx="6" cy="12" r="3"/>
                                    <circle cx="18" cy="19" r="3"/>
                                    <path d="M8.6 10.7l6.8-3.9M8.6 13.3l6.8 3.9"/>
                                </svg>
                            </button>
                            @ToolbarContent
                        </div>
                    </div>
                    <PaneResizer Id="@toolsResizerId" Direction="y" OnReset="ResetToolsPane" />
                    <EditorTools @ref="editorTools"
                                 Expanded="toolsExpanded"
                                 ActiveTool="activeTool"
                                 HeadersEnabled="IsHeadersEditorEnabled"
                                 Style="@(toolsExpanded ? Grow(1 - toolsPane.Ratio) : "flex: 0 0 auto")"
                                 VariablesConstruction="@(hydrated ? VariablesOptions : null)"
                                 HeadersConstruction="@(hydrated ? HeadersOptions : null)"
                                 OnVariablesInit="OnVariablesInit"
                                 OnHeadersInit="OnHeadersInit"
                                 OnVariablesChanged="OnVariablesContentChanged"
                                 OnHeadersChanged="OnHeadersContentChanged"
                                 OnSelectTool="SelectTool"
                                 OnToggle="ToggleTools" />
                </div>
                <PaneResizer Id="@sessionResizerId" Direction="x" OnReset="() => ResetPane(sessionPane)" />
                <div class="blazorql-response" style="@Grow(1 - sessionPane.Ratio)">
                    <section class="blazorql-editor-host" aria-label="Result Window" aria-live="polite" aria-atomic="true">
                        @if (hydrated)
                        {
                            <StandaloneCodeEditor @ref="responseEditor"
                                                  Id="@ResponseElementId"
                                                  CssClass="blazorql-editor"
                                                  ConstructionOptions="ResponseOptions"
                                                  OnDidInit="OnResponseInit"
                                                  OnDidChangeModelContent="OnResponseContentChanged" />
                        }
                        @if (HasResponse)
                        {
                            <div class="blazorql-response-actions">
                                <button type="button"
                                        class="blazorql-toolbar-button"
                                        data-testid="response-copy"
                                        title="Copy response"
                                        aria-label="Copy response"
                                        @onclick="CopyResponse">
                                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <rect x="9" y="9" width="12" height="12" rx="2"/>
                                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                                    </svg>
                                </button>
                                <button type="button"
                                        class="blazorql-toolbar-button"
                                        data-testid="response-download"
                                        title="Download response"
                                        aria-label="Download response"
                                        @onclick="DownloadResponse">
                                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <path d="M12 3v12m0 0l-4-4m4 4l4-4"/>
                                        <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>
                                    </svg>
                                </button>
                            </div>
                        }
                        @if (running)
                        {
                            <div class="blazorql-spinner" data-testid="spinner">
                                <div class="blazorql-spinner-circle"></div>
                            </div>
                        }
                    </section>
                    <ResponseErrorList Errors="ResponseFieldErrors" OnRemove="RemoveErroredField" />
                    @if (statusLine is not null)
                    {
                        <div class="blazorql-status-line" data-testid="status-line">@statusLine</div>
                    }
                    @if (FooterContent is not null)
                    {
                        <footer class="blazorql-session-footer">@FooterContent</footer>
                    }
                </div>
            </div>
        </div>
    </div>
    @if (settingsOpen)
    {
        <SettingsDialog ShowPersistHeaders="IsHeadersEditorEnabled"
                        PersistHeaders="persistHeaders"
                        OnPersistHeadersChanged="SetPersistHeaders"
                        ShowTheme="ForcedTheme is null"
                        Theme="themes.Current"
                        OnThemeSelected="SelectTheme"
                        ClearStorageAction="ClearStorage"
                        OnClose="CloseSettings" />
    }
    @if (shortKeysOpen)
    {
        <ShortKeysDialog OnClose="CloseShortKeys" />
    }
</div>
