@namespace BlazorQL

<div class="blazorql-tabs" role="tablist" aria-label="Select active operation">
    @for (var i = 0; i < Store.Tabs.Count; i++)
    {
        var index = i;
        var tab = Store.Tabs[index];
        var active = index == Store.ActiveIndex;
        <div class="blazorql-tab @(active ? "blazorql-active" : null)"
             role="tab"
             aria-selected="@(active ? "true" : "false")"
             @key="tab.Id">
            @if (renamingIndex == index)
            {
                <input class="blazorql-tab-rename"
                       @ref="renameInput"
                       @bind="renameText"
                       @bind:event="oninput"
                       @onkeydown="_ => OnRenameKey(_, index)"
                       @onblur="CancelRename" />
            }
            else
            {
                <button type="button"
                        class="blazorql-tab-button"
                        @onclick="() => OnActivate.InvokeAsync(index)"
                        @ondblclick="() => StartRename(index)">@Title(tab)</button>
                @if (Store.Tabs.Count > 1)
                {
                    <button type="button"
                            class="blazorql-tab-close"
                            aria-label="Close Tab"
                            @onclick="() => OnClose.InvokeAsync(index)">
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M6 6l12 12M18 6L6 18"/>
                        </svg>
                    </button>
                }
            }
        </div>
    }
    <button type="button"
            class="blazorql-tab-add"
            data-testid="tab-add"
            aria-label="New tab"
            title="New tab"
            @onclick="() => OnAdd.InvokeAsync()">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 5v14M5 12h14"/>
        </svg>
    </button>
    <button type="button"
            class="blazorql-tab-import"
            data-testid="tab-import"
            aria-label="Import request into a new tab"
            title="Import request into a new tab"
            @onclick="() => OnImport.InvokeAsync()">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1z"/>
            <path d="M16 5h2a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2"/>
            <path d="M12 10v6m0 0l-2.5-2.5M12 16l2.5-2.5"/>
        </svg>
    </button>
</div>
