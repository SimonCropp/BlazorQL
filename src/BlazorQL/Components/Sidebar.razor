@namespace BlazorQL

<aside class="blazorql-sidebar" aria-label="Sidebar">
    <div class="blazorql-sidebar-group">
        <button type="button"
                class="blazorql-sidebar-button @(Visible == PluginKind.Docs ? "blazorql-active" : null)"
                data-testid="sidebar-docs"
                title="Show Documentation Explorer"
                aria-label="Show Documentation Explorer"
                @onclick="() => OnToggle.InvokeAsync(PluginKind.Docs)">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H19v18H7.5A2.5 2.5 0 0 0 5 22z"/>
                <path d="M5 19.5A2.5 2.5 0 0 1 7.5 17H19"/>
            </svg>
        </button>
        <button type="button"
                class="blazorql-sidebar-button @(Visible == PluginKind.History ? "blazorql-active" : null)"
                data-testid="sidebar-history"
                title="Show History"
                aria-label="Show History"
                @onclick="() => OnToggle.InvokeAsync(PluginKind.History)">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="9"/>
                <path d="M12 7v5l3.5 2"/>
            </svg>
        </button>
    </div>
    <div class="blazorql-sidebar-group">
        <button type="button"
                class="blazorql-sidebar-button @(Refetching ? "blazorql-spin" : null)"
                data-testid="refetch"
                title="Re-fetch GraphQL schema"
                aria-label="Re-fetch GraphQL schema"
                disabled="@Refetching"
                @onclick="OnRefetch">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M20 12a8 8 0 1 1-2.34-5.66"/>
                <path d="M20 3v4h-4"/>
            </svg>
        </button>
        <button type="button"
                class="blazorql-sidebar-button"
                data-testid="theme-toggle"
                title="Theme: @Theme"
                aria-label="Switch theme (current: @Theme)"
                @onclick="OnThemeToggle">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/>
            </svg>
        </button>
        <button type="button"
                class="blazorql-sidebar-button"
                data-testid="shortkeys"
                title="Open short keys dialog"
                aria-label="Open short keys dialog"
                @onclick="OnOpenShortKeys">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="2" y="6" width="20" height="12" rx="2"/>
                <path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M6 14h.01M18 14h.01M9 14h6"/>
            </svg>
        </button>
        <button type="button"
                class="blazorql-sidebar-button"
                data-testid="settings"
                title="Open settings dialog"
                aria-label="Open settings dialog"
                @onclick="OnOpenSettings">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1.03 1.56V21a2 2 0 1 1-4 0v-.09A1.7 1.7 0 0 0 9 19.36a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.64 15a1.7 1.7 0 0 0-1.55-1.03H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.64 9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.64a1.7 1.7 0 0 0 1.03-1.55V3a2 2 0 1 1 4 0v.09c0 .68.4 1.29 1.03 1.55a1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87c.26.62.87 1.03 1.55 1.03H21a2 2 0 1 1 0 4h-.09c-.68 0-1.29.4-1.51 1.03z"/>
            </svg>
        </button>
    </div>
</aside>
