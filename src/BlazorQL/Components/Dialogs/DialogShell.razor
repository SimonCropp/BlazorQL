@namespace BlazorQL

<div class="blazorql-dialog-overlay"
     @onclick="() => OnClose.InvokeAsync()"
     @onkeydown="OnKeyDown">
    <div class="blazorql-dialog"
         data-testid="@TestId"
         role="dialog"
         aria-label="@Title"
         tabindex="-1"
         @ref="panel"
         @onclick:stopPropagation>
        <header class="blazorql-dialog-header">
            <h2 class="blazorql-dialog-title">@Title</h2>
            <button type="button"
                    class="blazorql-dialog-close"
                    aria-label="Close dialog"
                    title="Close dialog"
                    @onclick="() => OnClose.InvokeAsync()">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M6 6l12 12M18 6L6 18"/>
                </svg>
            </button>
        </header>
        @ChildContent
    </div>
</div>
