@namespace BlazorQL

@*
    The Variables/Headers strip under the operation editor. The editor host elements are always in
    the DOM — the two Monaco editors are created once at boot and shown/hidden with CSS so their
    undo/scroll state survives tab flips and collapses.
*@
<section class="blazorql-editor-tools @(Expanded ? null : "blazorql-collapsed")" style="@Style" aria-label="Editor Tools">
    <div class="blazorql-editor-tools-header">
        <button type="button"
                class="blazorql-tool-button @(Expanded && ActiveTool == EditorTool.Variables ? "blazorql-active" : null)"
                data-testid="tools-variables"
                @onclick="() => OnSelectTool.InvokeAsync(EditorTool.Variables)">Variables</button>
        @if (HeadersEnabled)
        {
            <button type="button"
                    class="blazorql-tool-button @(Expanded && ActiveTool == EditorTool.Headers ? "blazorql-active" : null)"
                    data-testid="tools-headers"
                    @onclick="() => OnSelectTool.InvokeAsync(EditorTool.Headers)">Headers</button>
        }
        <button type="button"
                class="blazorql-tools-chevron"
                aria-label="@(Expanded ? "Hide editor tools" : "Show editor tools")"
                title="@(Expanded ? "Hide editor tools" : "Show editor tools")"
                @onclick="() => OnToggle.InvokeAsync()">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="@(Expanded ? "blazorql-chevron-down" : "blazorql-chevron-up")">
                <path d="M6 9l6 6 6-6"/>
            </svg>
        </button>
    </div>
    <div class="blazorql-editor-tools-body">
        <div class="blazorql-editor-host @(ActiveTool == EditorTool.Variables ? null : "blazorql-hidden")" aria-label="Variables">
            <div id="@VariablesElementId" class="blazorql-editor"></div>
        </div>
        <div class="blazorql-editor-host @(ActiveTool == EditorTool.Headers ? null : "blazorql-hidden")" aria-label="Request Headers">
            <div id="@HeadersElementId" class="blazorql-editor"></div>
        </div>
    </div>
</section>

@code {

    internal const string VariablesElementId = "blazorql-variables-editor";
    internal const string HeadersElementId = "blazorql-headers-editor";

    [Parameter]
    public bool Expanded { get; set; }

    [Parameter]
    public EditorTool ActiveTool { get; set; }

    [Parameter]
    public bool HeadersEnabled { get; set; } = true;

    /// <summary>Inline flex sizing supplied by the parent's pane state.</summary>
    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public EventCallback<EditorTool> OnSelectTool { get; set; }

    [Parameter]
    public EventCallback OnToggle { get; set; }

}
