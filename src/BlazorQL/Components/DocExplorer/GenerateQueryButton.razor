@namespace BlazorQL

<button type="button"
        class="blazorql-doc-generate"
        data-testid="doc-generate"
        title="Generate a query for @Type.Name"
        aria-label="Generate a query for @Type.Name"
        @onclick="() => OnClick.InvokeAsync(Type)">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M8 6l-5 6 5 6"/>
        <path d="M16 6l5 6-5 6"/>
    </svg>
</button>
