@namespace BlazorQL

<div class="blazorql-doc-page" data-testid="doc-root">
    <MarkdownView Content="@Schema.Description"
                  Fallback="A GraphQL schema provides a root type for each kind of operation." />

    <div class="blazorql-doc-section-title">Root Types</div>
    <div class="blazorql-doc-root-types">
        @foreach (var (operation, typeName) in RootTypes())
        {
            var type = Schema.Find(typeName);
            if (type is null)
            {
                continue;
            }

            <div class="blazorql-doc-root-type">
                <span class="blazorql-doc-keyword">@operation</span><span>: </span>
                <TypeLink Type="new() {Kind = type.Kind, Name = type.Name}" OnNavigate="OnNavigateType" />
                <GenerateQueryButton Type="type" OnClick="OnGenerateQuery" />
            </div>
        }
    </div>

    <div class="blazorql-doc-section-title">All Schema Types</div>
    <div class="blazorql-doc-type-list">
        @foreach (var type in OtherTypes())
        {
            <div>
                <TypeLink Type="new() {Kind = type.Kind, Name = type.Name}" OnNavigate="OnNavigateType" />
                @if (QueryGenerator.CanGenerateOperation(Schema, type))
                {
                    <GenerateQueryButton Type="type" OnClick="OnGenerateQuery" />
                }
                @if (QueryGenerator.CanGenerate(type))
                {
                    <CopyGeneratedButton Type="type"
                                         IsOperation="QueryGenerator.CanGenerateOperation(Schema, type)"
                                         OnClick="OnCopyGenerated" />
                }
            </div>
        }
    </div>
</div>
