@namespace BlazorQL

@*
    Renders a type reference with its full wrapper nesting (e.g. [Foo!]!) where only the named
    part is clickable.
*@
<span class="blazorql-type-ref">@prefix<button type="button" class="blazorql-type-link" @onclick="Navigate">@name</button>@suffix</span>

@code {

    string prefix = "";
    string suffix = "";
    string name = "";

    [Parameter]
    [EditorRequired]
    public TypeRef Type { get; set; } = null!;

    /// <summary>Raised with the named type's name when the link is clicked.</summary>
    [Parameter]
    public EventCallback<string> OnNavigate { get; set; }

    protected override void OnParametersSet()
    {
        // Outside-in over the wrappers: each one contributes its closing character before the
        // characters already collected, so NON_NULL(LIST(NON_NULL(Foo))) renders [Foo!]!.
        prefix = "";
        suffix = "";
        var current = Type;
        while (current.OfType is not null)
        {
            if (current.Kind == "LIST")
            {
                prefix += "[";
                suffix = "]" + suffix;
            }
            else if (current.Kind == "NON_NULL")
            {
                suffix = "!" + suffix;
            }

            current = current.OfType;
        }

        name = current.Name ?? "";
    }

    Task Navigate() =>
        OnNavigate.InvokeAsync(name);

}
