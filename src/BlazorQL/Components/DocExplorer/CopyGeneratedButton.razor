@namespace BlazorQL

<button type="button"
        class="blazorql-doc-copy"
        data-testid="doc-copy-generated"
        title="@($"Copy {(IsOperation ? "a query" : "a fragment")} for {Type.Name}")"
        aria-label="@($"Copy {(IsOperation ? "a query" : "a fragment")} for {Type.Name}")"
        @onclick="() => OnClick.InvokeAsync(Type)">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="9" y="9" width="12" height="12" rx="2"/>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
    </svg>
</button>

@code
{
    [Parameter]
    [EditorRequired]
    public IntrospectionType Type { get; set; } = null!;

    /// <summary>
    /// Whether the copy would be a runnable operation. Only the wording depends on it, but a
    /// fragment and a query are different enough things that the button should say which.
    /// </summary>
    [Parameter]
    public bool IsOperation { get; set; }

    [Parameter]
    public EventCallback<IntrospectionType> OnClick { get; set; }
}
