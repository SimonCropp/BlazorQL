@namespace BlazorQL

<div class="blazorql-history" data-testid="history-pane">
    <div class="blazorql-history-toolbar">
        <input class="blazorql-history-search"
               data-testid="history-search"
               type="search"
               placeholder="Search history…"
               aria-label="Search history"
               @bind="filter"
               @bind:event="oninput" />
        <button type="button"
                class="blazorql-history-clear"
                data-testid="history-clear"
                disabled="@(Store.Items.Count == 0)"
                @onclick="Clear">Clear</button>
    </div>
    <ul class="blazorql-history-list">
        @foreach (var item in Store.Favorites.Where(_ => HistoryStore.Matches(_, filter)))
        {
            @RenderItem(item)
        }
        @if (Store.Favorites.Count > 0 && Store.Items.Count > 0)
        {
            <li class="blazorql-history-spacer" aria-hidden="true"></li>
        }
        @foreach (var item in Store.Items.Where(_ => HistoryStore.Matches(_, filter)))
        {
            @RenderItem(item)
        }
    </ul>
</div>

@code {

    RenderFragment RenderItem(HistoryItem item) =>
        @<li class="blazorql-history-row @(item.Favorite ? "blazorql-favorite" : null)" @key="item">
            @if (editing == item)
            {
                <input class="blazorql-history-label-input"
                       data-testid="history-label-input"
                       @ref="editInput"
                       @bind="editText"
                       @bind:event="oninput"
                       @onkeydown="OnEditKey"
                       @onblur="CancelEdit" />
            }
            else
            {
                <button type="button"
                        class="blazorql-history-item"
                        data-testid="history-item"
                        title="@item.Query"
                        @onclick="() => OnSelect.InvokeAsync(item)">@HistoryStore.DisplayText(item)</button>
                <span class="blazorql-history-actions">
                    <button type="button"
                            class="blazorql-history-action"
                            aria-label="Edit label"
                            title="Edit label"
                            @onclick="() => StartEdit(item)">
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>
                        </svg>
                    </button>
                    <button type="button"
                            class="blazorql-history-action @(item.Favorite ? "blazorql-active" : null)"
                            aria-label="@(item.Favorite ? "Remove favorite" : "Add favorite")"
                            title="@(item.Favorite ? "Remove favorite" : "Add favorite")"
                            @onclick="() => ToggleFavorite(item)">
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="@(item.Favorite ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.5">
                            <path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/>
                        </svg>
                    </button>
                    <button type="button"
                            class="blazorql-history-action"
                            aria-label="Delete from history"
                            title="Delete from history"
                            @onclick="() => Delete(item)">
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M6 6l12 12M18 6L6 18"/>
                        </svg>
                    </button>
                </span>
            }
        </li>;

}
