@namespace BlazorQL

<div class="blazorql-plugin-pane" data-testid="plugin-pane" style="@Style">
    <div class="blazorql-plugin-title">@Title</div>
    @switch (Kind)
    {
        case PluginKind.Docs:
            <DocExplorer Schema="Schema"
                         SdlProvider="SdlProvider"
                         Navigator="Navigator"
                         OnGenerateQuery="OnGenerateQuery"
                         OnCopyGenerated="OnCopyGenerated" />
            break;
        case PluginKind.Builder:
            <QueryBuilderPane Schema="Schema"
                              Query="@Query"
                              OnEdit="OnBuilderEdit"
                              OnVariablesEdit="OnBuilderVariablesEdit" />
            break;
        default:
            @if (History is not null)
            {
                <HistoryPane Store="History" OnSelect="OnHistorySelect" />
            }
            break;
    }
</div>
