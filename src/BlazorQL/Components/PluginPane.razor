@namespace BlazorQL

<div class="blazorql-plugin-pane" data-testid="plugin-pane" style="@Style">
    <div class="blazorql-plugin-title">@Title</div>
    @if (Kind == PluginKind.Docs)
    {
        <DocExplorer Schema="Schema" SchemaSdl="@SchemaSdl" Navigator="Navigator" />
    }
    else if (History is not null)
    {
        <HistoryPane Store="History" OnSelect="OnHistorySelect" />
    }
</div>
