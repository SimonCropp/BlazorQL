<Project>

  <!--
    Monaco ships 122 static web assets and BlazorQL loads 15 of them, but "unused" and "unreachable"
    are not the same thing here, so this drops only what no schema can reach.

    The trap is that grammar loading is driven by the content being displayed, not by the languages
    BlazorQL puts on its models. The graphql grammar maps a """ description block to
    nextEmbedded:"markdown", and the markdown grammar maps a fenced code block to nextEmbedded:"$1"
    - the language named in the fence. So a schema whose description contains a ```python example
    makes monaco fetch the python grammar. That set is the user's schema, not ours, and it cannot be
    enumerated. Every basic-languages grammar therefore stays.

    What does not depend on schema content:

      - The 14 nls.messages.* locale bundles. nls.messages-loader.js only requires one when
        require.config({'vs/nls':{availableLanguages:...}}) has been set, and nothing sets it.

      - The typescript, css and html workers. A worker is spawned by a language service running
        against a model of that language, and BlazorQL only ever creates graphql and json models.
        Embedded tokenization inside a fenced block uses the grammar, not the worker.

    That is 9.96 MiB of the 15.01, and ts.worker alone is 6.69 of it.

    Deliberately a denylist rather than an allowlist. An allowlist that misses a renamed chunk
    silently drops a file that turns into a 404 inside the editor; a denylist that misses one
    silently keeps it, which only costs bytes. The count check below turns either into a build
    error, but the direction of the failure still matters.
  -->

  <PropertyGroup>
    <BlazorMonacoDropPattern>^lib/monaco-editor/min/vs/(nls\.messages\.[^/]*\.js|assets/(ts|css|html)\.worker-[^/]+\.js)$</BlazorMonacoDropPattern>
    <BlazorMonacoExpectedDropCount>17</BlazorMonacoExpectedDropCount>
  </PropertyGroup>

  <!--
    Build time, not publish time. LoadStaticWebAssetsBuildManifest removes every StaticWebAsset and
    StaticWebAssetEndpoint and re-hydrates them from staticwebassets.build.json, so a filter applied
    during publish is discarded. Filtering here also means dotnet run and dotnet publish agree.
  -->
  <Target Name="PruneBlazorMonacoStaticWebAssets"
          AfterTargets="ResolveCoreStaticWebAssets"
          BeforeTargets="GenerateComputedBuildStaticWebAssets">

    <ItemGroup>
      <_MonacoAsset Include="@(StaticWebAsset)"
                    Condition="'%(StaticWebAsset.SourceId)' == 'BlazorMonaco'" />
      <_MonacoDrop Include="@(_MonacoAsset)"
                   Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RelativePath)', '$(BlazorMonacoDropPattern)'))" />
      <!--
        Endpoints join to their asset on AssetFile, and one asset has several endpoints
        (fingerprinted, label, and one per content encoding). Carrying the asset path across under
        that metadata name removes an asset and all of its endpoints with one predicate; an endpoint
        left behind would advertise a route to a file that is no longer published.
      -->
      <_MonacoDropKey Include="@(_MonacoDrop)">
        <AssetFile>%(Identity)</AssetFile>
      </_MonacoDropKey>
    </ItemGroup>

    <Error Condition="'@(_MonacoAsset->Count())' == '0'"
           Text="No BlazorMonaco static web assets were found. The package no longer sets SourceId=BlazorMonaco, so MonacoAssets.targets is silently doing nothing." />
    <Error Condition="'@(_MonacoDrop->Count())' != '$(BlazorMonacoExpectedDropCount)'"
           Text="Monaco pruning dropped @(_MonacoDrop->Count()) assets, expected $(BlazorMonacoExpectedDropCount). BlazorMonaco's asset layout changed - review BlazorMonacoDropPattern in MonacoAssets.targets against the new version, then update BlazorMonacoExpectedDropCount." />

    <ItemGroup>
      <StaticWebAsset Remove="@(_MonacoDrop)" />
      <StaticWebAssetEndpoint Remove="@(_MonacoDropKey)"
                              MatchOnMetadata="AssetFile"
                              MatchOnMetadataOptions="PathLike" />
    </ItemGroup>

    <Message Importance="normal"
             Text="Monaco assets: dropped @(_MonacoDrop->Count()) of @(_MonacoAsset->Count())." />
  </Target>

</Project>
