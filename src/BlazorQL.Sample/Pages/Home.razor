@page "/"
@namespace BlazorQL.Sample
@using BlazorQL
@inject IGraphQLFetcher Fetcher

<div class="home">
    <header class="home-header">
        <div>
            <h1>BlazorQL sample app</h1>
            <p>
                An ordinary Blazor page consuming a GraphQL API — every request below goes through
                the same fetcher the query explorer uses, so the debug sidecar (<kbd>Alt</kbd>+<kbd>G</kbd>
                or the corner button) shows each one as it happens: the operation, variables,
                headers, and every response document.
            </p>
        </div>
        <a class="home-explorer-link" data-testid="open-explorer" href="explorer">Open the query explorer</a>
    </header>

    <div class="home-cards">
        <section class="home-card" data-testid="home-profile">
            <h2>Profile</h2>
            <p class="home-hint">A query, run when the page loads.</p>
            @if (profileError is not null)
            {
                <p class="home-error" data-testid="home-profile-error">@profileError</p>
            }
            else if (profile is null)
            {
                <p class="home-hint">Loading…</p>
            }
            else
            {
                <p class="home-name" data-testid="home-name">@profile.Name <span class="home-age">age @profile.Age</span></p>
                <ul class="home-friends" data-testid="home-friends">
                    @foreach (var friend in profile.Friends)
                    {
                        <li>@friend</li>
                    }
                </ul>
            }
        </section>

        <section class="home-card" data-testid="home-echo">
            <h2>Echo</h2>
            <p class="home-hint">A mutation, sent when the button is clicked.</p>
            <div class="home-echo-row">
                <input data-testid="home-echo-input" @bind="echoInput" />
                <button type="button" data-testid="home-echo-send" @onclick="SendAsync">Send</button>
            </div>
            @if (echoResult is not null)
            {
                <p class="home-echo-result" data-testid="home-echo-result">The server echoed: <strong>@echoResult</strong></p>
            }
        </section>

        <section class="home-card" data-testid="home-feed">
            <h2>Live greetings</h2>
            <p class="home-hint">A subscription — one request, a stream of documents.</p>
            <button type="button" data-testid="home-feed-toggle" @onclick="ToggleFeedAsync">
                @(feed is null ? "Start" : "Stop")
            </button>
            <ul class="home-greetings" data-testid="home-greetings">
                @foreach (var greeting in greetings)
                {
                    <li>@greeting</li>
                }
            </ul>
        </section>
    </div>
</div>

@* The debug panel belongs to this consuming app: the explorer page is the IDE itself, and
   deliberately does not render it. *@
<BlazorQLSidecar />
