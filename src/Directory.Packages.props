    <PackageVersion Include="BlazorMonaco" Version="3.5.0" />
    <PackageVersion Include="GraphQL" Version="8.8.5" />
    <PackageVersion Include="GraphQL.SystemTextJson" Version="8.8.5" />
    <PackageVersion Include="GraphQL-Parser" Version="9.5.1" />
    <PackageVersion Include="HttpMultipart" Version="0.1.1" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="Verify.NUnit" Version="33.0.0-beta.3" />
    <PackageVersion Include="Verify.Bunit" Version="14.0.0" />
    <PackageVersion Include="Verify.Playwright" Version="3.1.1" />
    <PackageVersion Include="Verify.DiffPlex" Version="3.3.1" />
    <PackageVersion Include="DiffEngine" Version="20.2.0" />
    <PackageVersion Include="Polyfill" Version="11.2.0" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.180" />
    <PackageVersion Include="ProjectFiles" Version="1.4.0" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="28.4.2" />
  </ItemGroup>
</Project>
