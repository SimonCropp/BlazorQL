<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="BlazorMonaco" Version="3.5.0" />
    <PackageVersion Include="GraphQL" Version="8.8.5" />
    <PackageVersion Include="GraphQL.SystemTextJson" Version="8.8.5" />
    <PackageVersion Include="GraphQL-Parser" Version="9.5.1" />
    <PackageVersion Include="HttpMultipart" Version="1.1.0" />
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="TUnit" Version="1.73.5" />
    <PackageVersion Include="Verify.TUnit" Version="33.3.2" />
    <PackageVersion Include="Verify.Bunit" Version="14.1.0" />
    <PackageVersion Include="Verify.Playwright" Version="3.1.1" />
    <PackageVersion Include="DiffEngine" Version="20.7.2" />
    <PackageVersion Include="Polyfill" Version="11.4.3" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.184" />
    <PackageVersion Include="ProjectFiles" Version="1.6.0" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="28.5.0" />
  </ItemGroup>
</Project>
