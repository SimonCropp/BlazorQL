<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="BlazorMonaco" Version="3.5.0" />
    <PackageVersion Include="GraphQL" Version="8.8.5" />
    <PackageVersion Include="GraphQL.SystemTextJson" Version="8.8.5" />
    <PackageVersion Include="GraphQL-Parser" Version="9.5.1" />
    <PackageVersion Include="HttpMultipart" Version="1.1.0" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.65.0" />
    <PackageVersion Include="TUnit" Version="1.87.0" />
    <PackageVersion Include="Verify.TUnit" Version="33.6.0" />
    <PackageVersion Include="Verify.Bunit" Version="14.1.0" />
    <PackageVersion Include="Verify.Playwright" Version="3.3.0" />
    <PackageVersion Include="DiffEngine" Version="21.1.0" />
    <PackageVersion Include="Polyfill" Version="11.4.5" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.190" />
    <PackageVersion Include="ProjectFiles" Version="1.6.0" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="30.0.1" />
  </ItemGroup>
</Project>
