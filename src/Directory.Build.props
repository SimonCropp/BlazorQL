<Project>
  <PropertyGroup>
    <!-- BL0016 wants every JS interop call inside a try/catch. The calls it flags are pass-through
         wrappers whose callers decide what a failure means (JsModule), module import and init, and
         the bundled host's startup config read: a catch at any of them could only swallow a
         failure that should surface. Disconnects are caught where they are expected
         (JsModule.DisposeAsync). -->
    <NoWarn>CS1591;NU1608;NU1109;PolyfillTargetsForNuget;BL0016</NoWarn>
    <Version>2.0.0</Version>
    <LangVersion>14.0</LangVersion>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <Description>BlazorQL is an in-browser GraphQL IDE for Blazor: a GraphiQL alternative with schema-aware editing, docs, history, tabs, and subscriptions.</Description>
    <ResolveAssemblyReferencesSilent>true</ResolveAssemblyReferencesSilent>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Audit the full transitive dependency graph. Combined with TreatWarningsAsErrors this fails
         the build on any package vulnerability advisory (e.g. NU1903). -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <!-- Not strong-named: nothing here names internals-friends across a trust boundary, and an
         unsigned assembly keeps InternalsVisibleTo by simple name. -->
    <SignAssembly>false</SignAssembly>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-08</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.Threading.CancellationToken"
           Alias="Cancel" />
    <Using Include="System.Threading.CancellationTokenSource"
           Alias="CancelSource" />
  </ItemGroup>
</Project>
